# ─────────────────────────────────────────────────────────────────────────────
# Server Monitor — environment variables
# Copy this file to .env and fill in your values, or run: ./setup.sh
# ─────────────────────────────────────────────────────────────────────────────

# InfluxDB
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
INFLUXDB_ORG=monitoring
INFLUXDB_BUCKET=server_metrics
INFLUXDB_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
